# LaunchDarkly
LAUNCHDARKLY_API_TOKEN=
LAUNCHDARKLY_PROJECT_KEY=

# Sentry
SENTRY_ORG_SLUG=
SENTRY_AUTH_TOKEN=

# Vercel
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Gemini (replaces Anthropic in playbook)
GEMINI_API_KEY=

# Models
GEMINI_VERDICT_MODEL=gemini-2.5-pro
GEMINI_DISCOVERY_MODEL=gemini-2.5-flash

# Upstash Redis (Phase 2)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (Phase 3)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Slack (Phase 2-3)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
STUB_SLACK=true

# Stubs for missing sources
STUB_DATADOG=true
STUB_POSTHOG=true

# ── Phase 4: OpenTelemetry (Grafana Cloud) ──────────────────────────────────
# Leave empty in local dev — OTel is skipped gracefully when not set.
# Get these from https://grafana.com → My Account → Grafana Cloud Portal → Send Metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_AUTH_HEADER = "Basic <base64(instanceId:apiToken)>"
OTEL_AUTH_HEADER=

# Coral traces to the same Grafana OTLP backend
CORAL_OTEL_EXPORTER_OTLP_ENDPOINT=
# Same Base64 token as above, but as a raw k=v header
CORAL_OTEL_EXPORTER_OTLP_HEADERS=

# ── Webhook Signing Secrets (Phase 4.7) ─────────────────────────────────────
# Used in production to verify HMAC signatures from LaunchDarkly / Vercel.
LAUNCHDARKLY_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
